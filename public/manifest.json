{
  "manifest_version": 3,
  "name": "Authenticator",
  "version": "1.2.0",
  "description": "Generate time-based one-time passwords for your Google Authenticator.",
  "action": { "default_popup": "index.html", "default_title": "Authenticator" },
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}